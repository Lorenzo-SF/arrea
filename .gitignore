# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
arrea-*.tar

# Ignore compiled escript binary
/Arrea

# --- OS junk ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# --- Editor / IDE ---
.idea/
.vscode/
*.sublime-*
.elixir_ls/

# --- Logs ---
*.log

# --- ctags ---
/tags
/TAGS

# --- AI / opencode memory ---
/.opencode/

# --- Deploy script ---
/deploy.sh

# --- Dialyzer PLTs ---
/priv/plts/
graphify-out/
.specify/

# `/arrea` y no `arrea`. Sin la barra inicial git casa con cualquier fichero
# **o directorio** llamado `arrea` a cualquier nivel, y los primeros que
# encuentra son `lib/arrea/` y `test/arrea/`. Hoy estan versionados y no pasa
# nada, pero en cuanto uno se borre y se vuelva a anadir, `git add` lo ignora
# en silencio y el fichero se pierde. Es el mismo bug que ya se corrigio en el
# `.gitignore` de candil.
/arrea
